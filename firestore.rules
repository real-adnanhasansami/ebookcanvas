rules_version = '2';

// ============================================================
// Ebook Canvas — Firestore security rules (permanent, no expiry)
// Paste into Firebase Console → Firestore Database → Rules → Publish.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Defensive version: exists() + a defaulted get() so a missing or
    // incomplete user doc (e.g. a brand-new account) can never cause
    // the whole rule evaluation to error out and deny a query outright.
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // ---------------- users ----------------
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.isAdmin == false
        && request.resource.data.isPremium == false;

      // Owner can update their own doc, but never the access-control
      // fields — those are admin-only, always.
      allow update: if signedIn() && (
        (request.auth.uid == userId
          && request.resource.data.isAdmin == resource.data.isAdmin
          && request.resource.data.isPremium == resource.data.isPremium
          && request.resource.data.get('premiumPlan', null) == resource.data.get('premiumPlan', null)
          && request.resource.data.premiumExpiry == resource.data.premiumExpiry
          && request.resource.data.get('purchasedBooks', []) == resource.data.get('purchasedBooks', []))
        || isAdmin()
      );

      allow delete: if false;
    }

    // ---------------- books ----------------
    match /books/{bookId} {
      // Published books are readable by anyone, even signed-out visitors
      // (so the homepage/library can be browsed before signing up).
      // Clicking through to actually read still requires sign-in, enforced
      // by the reader page itself, not by this rule.
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ---------------- site settings (ads, banner, branding) ----------------
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------- account requests (deactivation/deletion) ----------------
    match /accountRequests/{reqId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ---------------- subscription requests (Premium plan requests) ----------
    match /subscriptionRequests/{reqId} {
      allow create: if request.resource.data.status == "pending";
      allow read, update, delete: if isAdmin();
    }

    // ---------------- per-book purchase requests ----------------
    match /bookPurchaseRequests/{reqId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ---------------- comments ----------------
    match /comments/{commentId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn();
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reported', 'likes', 'dislikes']);
      allow delete: if isAdmin();
    }

    // ---------------- ratings ----------------
    match /ratings/{ratingId} {
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn();
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
    }

    // ---------------- comment reactions (one vote per user per book) --------
    match /commentReactions/{docId} {
      allow read, write: if signedIn() && docId.matches(`.*_${request.auth.uid}`);
    }

    // ---------------- notes (per user, per book) ----------------
    match /notes/{noteId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
