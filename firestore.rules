rules_version = '2';

// ============================================================
// Ebook Canvas — Firestore security rules
//
// Replaces the default "open until a date" test-mode rules.
// These rules have no expiry and are meant to be your permanent
// rule set. Paste this into Firebase Console → Firestore Database
// → Rules, or deploy with `firebase deploy --only firestore:rules`.
//
// Admin is determined by users/{uid}.isAdmin == true. That field
// can only ever be changed by an existing admin (see the users
// rules below) — a normal user can never grant themself access,
// even by editing their own document directly.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ---------------- users ----------------
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      // A user may create only their own profile doc, and only with
      // isAdmin/isPremium false — matches what auth.js writes on signup.
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.isAdmin == false
        && request.resource.data.isPremium == false;

      // A user may update their own doc, but never the access-control
      // fields (isAdmin, isPremium, premiumPlan, premiumExpiry) — only
      // an admin can change those.
      allow update: if signedIn() && (
        (request.auth.uid == userId
          && request.resource.data.isAdmin == resource.data.isAdmin
          && request.resource.data.isPremium == resource.data.isPremium
          && request.resource.data.get('premiumPlan', null) == resource.data.get('premiumPlan', null)
          && request.resource.data.premiumExpiry == resource.data.premiumExpiry)
        || isAdmin()
      );

      allow delete: if false; // deletions happen through the manual request flow, not directly
    }

    // ---------------- books ----------------
    match /books/{bookId} {
      // Requires an account at minimum. Note: this does not fully enforce
      // the Premium paywall — the fileURL still points to a public
      // Cloudinary file, so a determined signed-in user could fetch it
      // directly. True DRM would need a backend/signed-URL layer; see README.
      allow read: if signedIn() && (resource.data.published == true || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ---------------- site settings (ads, etc.) ----------------
    match /site/{docId} {
      allow read: if true; // ad content is not sensitive, safe to read publicly
      allow write: if isAdmin();
    }

    // ---------------- account requests (deactivation/deletion) ----------------
    match /accountRequests/{reqId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ---------------- subscription requests (from the Premium page form) ------
    // Open to signed-out visitors too, since someone can request Premium
    // before creating an account. Only the admin can read or manage them.
    match /subscriptionRequests/{reqId} {
      allow create: if request.resource.data.status == "pending";
      allow read, update, delete: if isAdmin();
    }

    // ---------------- comments (per book, moderated by admin) -----------------
    match /comments/{commentId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn();
      // Any signed-in reader may flag a comment as reported, and nothing else.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reported']);
      allow delete: if isAdmin();
    }
  }
}
